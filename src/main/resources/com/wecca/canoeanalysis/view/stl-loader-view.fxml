<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>

<AnchorPane fx:id="moduleInjectionRoot" minHeight="0.0" minWidth="0.0" prefHeight="565.0" prefWidth="900.0" styleClass="background" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wecca.canoeanalysis.controllers.modules.StlLoaderController">
    <children>
        <Label layoutX="20.0" layoutY="17.0" styleClass="title" text="STL Loader" />
        <Label layoutX="112.0" layoutY="17.0" style="-fx-text-fill: -fx-primary-light; -fx-font-weight: bold;" text="BETA" />
        <Label layoutX="167.0" layoutY="19.0" prefWidth="713.0" styleClass="about-body" text="Extract a canoe outline and create a local preset draft from an ASCII or binary STL mesh." />

        <AnchorPane layoutX="20.0" layoutY="55.0" prefHeight="490.0" prefWidth="300.0" styleClass="surface">
            <children>
                <Label layoutX="18.0" layoutY="16.0" styleClass="subtitle" text="1. Import geometry" />
                <Label layoutX="18.0" layoutY="44.0" prefHeight="42.0" prefWidth="264.0" styleClass="about-body" text="Select the units used when the STL was exported. PADDL converts the result to metres." wrapText="true" />

                <Label layoutX="18.0" layoutY="94.0" styleClass="bold" text="STL source units" />
                <ComboBox fx:id="unitComboBox" layoutX="18.0" layoutY="114.0" prefHeight="32.0" prefWidth="264.0" />
                <JFXButton fx:id="chooseFileButton" layoutX="18.0" layoutY="158.0" onAction="#chooseStlFile" prefHeight="34.0" prefWidth="264.0" styleClass="action-object" text="Choose STL file" />
                <Label fx:id="fileNameLabel" layoutX="18.0" layoutY="201.0" prefHeight="36.0" prefWidth="264.0" styleClass="about-body" text="No file selected" textOverrun="CENTER_ELLIPSIS" wrapText="true" />
                <Line endX="264.0" layoutX="18.0" layoutY="246.0" styleClass="action-object" />

                <Label layoutX="18.0" layoutY="259.0" styleClass="subtitle" text="Mesh summary" />
                <Label layoutX="18.0" layoutY="288.0" styleClass="bold" text="Format" />
                <Label fx:id="formatValueLabel" layoutX="90.0" layoutY="288.0" prefWidth="192.0" styleClass="about-body" text="—" />
                <Label layoutX="18.0" layoutY="313.0" styleClass="bold" text="Mesh" />
                <Label fx:id="meshValueLabel" layoutX="90.0" layoutY="313.0" prefWidth="192.0" styleClass="about-body" text="—" />
                <Label layoutX="18.0" layoutY="338.0" styleClass="bold" text="L × W × H" />
                <Label fx:id="dimensionsValueLabel" layoutX="90.0" layoutY="338.0" prefWidth="192.0" styleClass="about-body" text="—" />

                <Label layoutX="18.0" layoutY="375.0" styleClass="subtitle" text="2. Name the draft" />
                <JFXTextField fx:id="presetNameField" labelFloat="true" layoutX="18.0" layoutY="406.0" prefWidth="172.0" promptText="Preset name" />
                <JFXTextField fx:id="presetYearField" labelFloat="true" layoutX="202.0" layoutY="406.0" prefWidth="80.0" promptText="Year" />
                <JFXButton fx:id="saveDraftButton" disable="true" layoutX="18.0" layoutY="448.0" onAction="#savePresetDraft" prefHeight="32.0" prefWidth="264.0" styleClass="action-object" text="Save local preset draft" />
            </children>
        </AnchorPane>

        <AnchorPane layoutX="340.0" layoutY="55.0" prefHeight="490.0" prefWidth="540.0" styleClass="surface">
            <children>
                <Label layoutX="18.0" layoutY="16.0" styleClass="subtitle" text="Derived geometry preview" />
                <Label layoutX="18.0" layoutY="43.0" prefHeight="35.0" prefWidth="504.0" styleClass="about-body" text="The longest mesh axis is treated as length. White dots show the sampled points written to the draft." wrapText="true" />
                <Canvas fx:id="previewCanvas" height="320.0" layoutX="10.0" layoutY="86.0" width="520.0" />
                <Label layoutX="18.0" layoutY="420.0" styleClass="bold" text="Detected axes" />
                <Label fx:id="axesValueLabel" layoutX="112.0" layoutY="420.0" prefWidth="410.0" styleClass="about-body" text="—" />
                <Label fx:id="statusLabel" layoutX="18.0" layoutY="448.0" prefHeight="32.0" prefWidth="504.0" styleClass="about-body" text="Beta drafts contain geometry only and are not automatically added to the preset menu." wrapText="true" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
